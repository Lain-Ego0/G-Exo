[core]
	repositoryformatversion = 0
	filemode = true
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
[remote "origin"]
	url = https://gitee.com/spacemit-robotics/ros2_peripherals
	projectname = ros2_peripherals
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "robot-dev"]
	remote = origin
	merge = refs/heads/main
