[core]
	repositoryformatversion = 0
	filemode = true
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
[remote "origin"]
	url = https://gitee.com/spacemit-robotics/peripherals_wifi
	projectname = peripherals_wifi
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "robot-dev"]
	remote = origin
	merge = refs/heads/main
