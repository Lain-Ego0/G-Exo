[core]
	repositoryformatversion = 0
	filemode = true
[filter "lfs"]
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
[remote "origin"]
	url = https://gitee.com/spacemit-robotics/lerobot
	projectname = lerobot
	fetch = +refs/heads/*:refs/remotes/origin/*
[maintenance]
	auto = false
[gc]
	auto = 0
[branch "robot-dev"]
	remote = origin
	merge = refs/heads/main
