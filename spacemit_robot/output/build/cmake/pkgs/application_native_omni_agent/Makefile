	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat.dir/build.make CMakeFiles/voice_chat.dir/src/voice_common.cpp.s
.PHONY : src/voice_common.cpp.s

src/voice_pipeline.o: src/voice_pipeline.cpp.o
.PHONY : src/voice_pipeline.o

# target to build an object file
src/voice_pipeline.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat_aec.dir/build.make CMakeFiles/voice_chat_aec.dir/src/voice_pipeline.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat.dir/build.make CMakeFiles/voice_chat.dir/src/voice_pipeline.cpp.o
.PHONY : src/voice_pipeline.cpp.o

src/voice_pipeline.i: src/voice_pipeline.cpp.i
.PHONY : src/voice_pipeline.i

# target to preprocess a source file
src/voice_pipeline.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat_aec.dir/build.make CMakeFiles/voice_chat_aec.dir/src/voice_pipeline.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat.dir/build.make CMakeFiles/voice_chat.dir/src/voice_pipeline.cpp.i
.PHONY : src/voice_pipeline.cpp.i

src/voice_pipeline.s: src/voice_pipeline.cpp.s
.PHONY : src/voice_pipeline.s

# target to generate assembly for a file
src/voice_pipeline.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat_aec.dir/build.make CMakeFiles/voice_chat_aec.dir/src/voice_pipeline.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/voice_chat.dir/build.make CMakeFiles/voice_chat.dir/src/voice_pipeline.cpp.s
.PHONY : src/voice_pipeline.cpp.s

