<?xml version="1.0"?>
<package format="3">
  <name>gexo_control</name>
  <version>0.1.0</version>
  <description>G-Exo ROS2 control node with RL+TCN and TCN+PD deployment strategies.</description>
  <maintainer email="gexo@example.com">G-Exo</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
